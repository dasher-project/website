---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Press Information - Dasher">
  <div class="container">
    <section class="section">
      <h1>Press Information</h1>

      <p class="lead">
        Media resources for journalists, bloggers, and content creators covering Dasher.
      </p>

      <section class="press-section">
        <h2>About Dasher</h2>
        <p>
          <strong>Dasher</strong> is a revolutionary text-entry interface that uses a zooming predictive
          text system. Originally developed by the Inference Group at the University of Cambridge, Dasher
          enables efficient text entry for people who cannot use standard keyboards.
        </p>
        <p>
          As an <strong>Alternative and Augmentative Communication (AAC)</strong> tool, Dasher serves
          users with physical disabilities, including those with conditions such as cerebral palsy, motor
          neurone disease, spinal cord injuries, and other conditions affecting hand function. It is also
          valuable for anyone seeking an alternative to traditional keyboard input.
        </p>
        <p>
          Dasher works with any continuous pointing device—mouse, touchscreen, eye-tracker,
          head-tracker, or switch—making it one of the most versatile text-entry systems available.
        </p>
      </section>

      <section class="press-section">
        <h2>Key Facts</h2>
        <div class="facts-grid">
          <div class="fact-card">
            <h3>Origins</h3>
            <p>
              Developed at the University of Cambridge Inference Group, led by Professor David
              MacKay (1997-present)
            </p>
          </div>
          <div class="fact-card">
            <h3>Users</h3>
            <p>
              Thousands of users worldwide, including people with disabilities, researchers, and
              accessibility professionals
            </p>
          </div>
          <div class="fact-card">
            <h3>Languages</h3>
            <p>Supports 60+ languages with customizable alphabet system</p>
          </div>
          <div class="fact-card">
            <h3>License</h3>
            <p>Open-source (GPL-3.0), freely available for all users</p>
          </div>
          <div class="fact-card">
            <h3>Platforms</h3>
            <p>Windows, macOS, Linux, Android, iOS</p>
          </div>
          <div class="fact-card">
            <h3>Speed</h3>
            <p>Expert users achieve 20-30 words per minute with eye-tracking alone</p>
          </div>
        </div>
      </section>

      <section class="press-section">
        <h2>Logo &amp; Assets</h2>
        <p>
          The Dasher logo and branding assets are available for use in press materials, articles,
          and presentations about Dasher.
        </p>

        <div class="assets-grid">
          <div class="asset-card">
            <h3>Primary Logo</h3>
            <div class="logo-preview">
              <img src="/logo.svg" alt="Dasher Logo" width="100" height="100" />
            </div>
            <p>
              <strong>Format:</strong> SVG<br />
              <strong>Usage:</strong> Primary logo for most applications
            </p>
            <a href="/logo.svg" class="btn-secondary" download>Download SVG</a>
          </div>

          <div class="asset-card">
            <h3>Icon</h3>
            <div class="logo-preview">
              <img src="/logo.svg" alt="Dasher Icon" width="64" height="64" />
            </div>
            <p>
              <strong>Format:</strong> SVG<br />
              <strong>Usage:</strong> Small sizes, favicons, app icons
            </p>
            <a href="/logo.svg" class="btn-secondary" download>Download SVG</a>
          </div>

          <div class="asset-card">
            <h3>Screenshot</h3>
            <div class="screenshot-preview">
              <img src="/images/dasher-banner.png" alt="Dasher Screenshot" width="200" />
            </div>
            <p>
              <strong>Format:</strong> PNG<br />
              <strong>Usage:</strong> Articles, presentations
            </p>
            <a href="/images/dasher-banner.png" class="btn-secondary" download>Download PNG</a>
          </div>
        </div>

        <div class="branding-guidelines">
          <h3>Branding Guidelines</h3>
          <ul>
            <li>Use the logo at sufficient size to remain legible</li>
            <li>Maintain clear space around the logo equal to at least half the logo height</li>
            <li>Do not stretch, distort, or rotate the logo</li>
            <li>Use provided colors when possible, or monochrome on colored backgrounds</li>
            <li>
              Dasher should always be written with a capital D: &quot;Dasher&quot;, not
              &quot;DASHER&quot; or &quot;dasher&quot;
            </li>
          </ul>
        </div>
      </section>

      <section class="press-section">
        <h2>Press Contacts</h2>

        <div class="contacts-grid">
          <div class="contact-card">
            <h3>General Inquiries</h3>
            <p>For general questions about Dasher, please use our community channels:</p>
            <ul>
              <li>
                <strong>Matrix Chat:</strong>
                <a href="https://matrix.to/#/#dasher:matrix.org">#dasher:matrix.org</a>
              </li>
              <li>
                <strong>GitHub Discussions:</strong>
                <a href="https://github.com/dasher-project">github.com/dasher-project</a>
              </li>
            </ul>
          </div>

          <div class="contact-card">
            <h3>Development Team</h3>
            <p>For technical inquiries or development questions:</p>
            <ul>
              <li>
                <strong>GitHub Issues:</strong>
                <a href="https://github.com/dasher-project">github.com/dasher-project</a>
              </li>
              <li>
                <strong>Main Repositories:</strong>
                <a href="https://github.com/dasher-project-core">dasher-core</a>, <a
                  href="https://github.com/dasher-project-gtk">dasher-gtk</a
                >
              </li>
            </ul>
          </div>

          <div class="contact-card">
            <h3>Accessibility Partners</h3>
            <p>Dasher has partnerships with several accessibility organizations:</p>
            <ul>
              <li>
                <strong>ACE Centre:</strong>
                <a href="https://acecentre.org.uk">acecentre.org.uk</a> - UK centre for AAC
              </li>
              <li>
                <strong>AbilityNet:</strong>
                <a href="https://abilitynet.org.uk">abilitynet.org.uk</a> - UK accessibility charity
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="press-section">
        <h2>Story Angles</h2>

        <div class="angles-list">
          <div class="angle-item">
            <h3>Breaking Barriers with Eye-Tracking</h3>
            <p>
              How Dasher enables completely hands-free text entry, allowing paralyzed users to write
              at 20-30 words per minute using only their eyes.
            </p>
          </div>

          <div class="angle-item">
            <h3>The Science Behind Dasher</h3>
            <p>
              Dasher is built on information theory—the interface is mathematically optimal for text
              entry given a language model. Published in <em>Nature</em> (2002).
            </p>
          </div>

          <div class="angle-item">
            <h3>Open-Source Accessibility</h3>
            <p>
              How a global community of developers maintains and improves Dasher, keeping it free
              and accessible to everyone who needs it.
            </p>
          </div>

          <div class="angle-item">
            <h3>Dasher v6: The Next Generation</h3>
            <p>
              A complete rewrite bringing modern architecture, improved performance, and expanded
              platform support for the next era of accessibility technology.
            </p>
          </div>

          <div class="angle-item">
            <h3>Global Language Support</h3>
            <p>
              Dasher breaks language barriers with support for 60+ languages, including Hindi,
              Arabic, Chinese, and many indigenous languages often overlooked by tech companies.
            </p>
          </div>

          <div class="angle-item">
            <h3>From Research to Real-World Impact</h3>
            <p>
              The journey from Cambridge research project to life-changing AAC tool used by
              thousands of people worldwide.
            </p>
          </div>
        </div>
      </section>

      <section class="press-section">
        <h2>Press Coverage</h2>
        <p>
          Dasher has been featured in numerous publications and media outlets. See our
          <a href="/docs/research/press/">Press Coverage</a> page for a complete list.
        </p>

        <div class="coverage-highlights">
          <h3>Notable Coverage</h3>
          <ul>
            <li>
              <em>Nature</em> - &quot;Dasher - A Data-Entry Interface Using Continuous Gestures and Language
              Models&quot; (2002)
            </li>
            <li><em>Scientific American</em> - Feature on accessible technology</li>
            <li><em>BBC Technology</em> - Multiple features on assistive technology</li>
            <li>Various disability and accessibility publications worldwide</li>
          </ul>
        </div>
      </section>

      <section class="press-section">
        <h2>Quick Links for Journalists</h2>
        <div class="quick-links">
          <a href="/about/" class="link-card">
            <h3>About Dasher</h3>
            <p>Full history and background</p>
          </a>
          <a href="/docs/research/publications/" class="link-card">
            <h3>Publications</h3>
            <p>Academic papers and research</p>
          </a>
          <a href="/about/#demonstrations" class="link-card">
            <h3>Demonstrations</h3>
            <p>Videos showing Dasher in action</p>
          </a>
          <a href="/docs/special-needs/" class="link-card">
            <h3>Accessibility</h3>
            <p>Dasher for special needs users</p>
          </a>
        </div>
      </section>
    </section>
  </div>
</BaseLayout>

<style>
  .press-section {
    margin-bottom: var(--space-2xl);
  }

  .press-section h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-horizon-mint);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .fact-card {
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border: 2px solid var(--color-horizon-mint);
    border-radius: var(--radius-md);
  }

  .fact-card h3 {
    margin-top: 0;
    margin-bottom: var(--space-sm);
    color: var(--color-target-coral);
  }

  .fact-card p {
    margin: 0;
  }

  .assets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }

  .asset-card {
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border: 2px solid var(--color-horizon-mint);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .asset-card h3 {
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .logo-preview,
  .screenshot-preview {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 120px;
    margin: var(--space-md) 0;
    background-color: var(--color-canvas-white);
    border-radius: var(--radius-md);
  }

  .logo-preview img,
  .screenshot-preview img {
    max-width: 100%;
    height: auto;
  }

  .branding-guidelines {
    padding: var(--space-lg);
    background-color: var(--color-horizon-mint);
    border-radius: var(--radius-md);
    margin-top: var(--space-lg);
  }

  .branding-guidelines h3 {
    margin-top: 0;
  }

  .contacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .contact-card {
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border-left: 4px solid var(--color-target-coral);
    border-radius: var(--radius-md);
  }

  .contact-card h3 {
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .contact-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-card li {
    margin-bottom: var(--space-xs);
  }

  .angles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .angle-item {
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border: 2px solid var(--color-horizon-mint);
    border-radius: var(--radius-md);
  }

  .angle-item h3 {
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .coverage-highlights {
    padding: var(--space-lg);
    background-color: var(--color-horizon-mint);
    border-radius: var(--radius-md);
    margin-top: var(--space-lg);
  }

  .coverage-highlights h3 {
    margin-top: 0;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .link-card {
    display: block;
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border: 2px solid var(--color-horizon-mint);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-deep-ink);
    transition: var(--transition-smooth);
  }

  .link-card:hover {
    border-color: var(--color-target-coral);
    transform: translateY(-2px);
  }

  .link-card h3 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .link-card p {
    margin: 0;
    opacity: 0.8;
  }
</style>
