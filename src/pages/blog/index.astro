---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Blog posts data
const posts = [
  {
    slug: 'announcing-dasher-v6',
    title: 'Announcing Dasher v6',
    date: '2020-01-15',
    category: 'Release',
    excerpt: 'We are excited to announce Dasher v6, a complete rewrite of the classic predictive text interface. This release brings modern architecture, improved performance, and expanded platform support.',
  },
  {
    slug: 'developer-update-june-2020',
    title: 'Developer Update - June 2020',
    date: '2020-06-01',
    category: 'Development',
    excerpt: 'Progress update on the v6 development: repository reorganization, proof of concept work on new input methods, and completion of NLNet milestone.',
  },
  {
    slug: 'new-site',
    title: 'New Website',
    date: '2020-01-10',
    category: 'News',
    excerpt: 'Welcome to the new Dasher website! We have updated our online presence to better serve our community and provide improved documentation.',
  },
  {
    slug: 'design-ideas',
    title: 'Design Ideas for v6',
    date: '2020-01-05',
    category: 'Development',
    excerpt: 'Exploring design concepts and ideas for the next generation of Dasher, including new interaction paradigms and accessibility improvements.',
  },
];
---

<BaseLayout title="Blog - Dasher">
  <div class="container">
    <section class="section">
      <h1>Blog</h1>
      <p class="lead">
        News, updates, and insights from the Dasher development team and community.
      </p>

      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-post-card">
            <div class="blog-meta">
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <span class="blog-tag">{post.category}</span>
            </div>
            <h2>
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="blog-excerpt">{post.excerpt}</p>
            <a href={`/blog/${post.slug}/`} class="btn-secondary">Read More</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lead {
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto var(--space-lg);
    text-align: center;
    opacity: 0.9;
  }

  .blog-list {
    display: grid;
    gap: var(--space-lg);
    max-width: 800px;
    margin: 0 auto;
  }

  .blog-post-card {
    background-color: var(--color-canvas-white);
    border: 2px solid var(--color-horizon-mint);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: var(--transition-smooth);
  }

  .blog-post-card:hover {
    border-color: var(--color-target-coral);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(39, 83, 123, 0.1);
  }

  .blog-meta {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-sm);
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .blog-tag {
    background-color: var(--color-horizon-mint);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .blog-post-card h2 {
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .blog-post-card h2 a {
    text-decoration: none;
    color: var(--color-deep-ink);
    transition: var(--transition-smooth);
  }

  .blog-post-card h2 a:hover {
    color: var(--color-target-coral);
  }

  .blog-excerpt {
    margin-bottom: var(--space-md);
    opacity: 0.8;
  }

  .blog-post-card .btn-secondary {
    margin-top: var(--space-sm);
  }
</style>
