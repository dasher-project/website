---
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Documentation - Dasher" description="Dasher documentation index">
  <div class="container">
    <section class="section">
      <h1>Documentation</h1>
      <p class="lead">
        Welcome to the Dasher documentation. Search or choose a section below to get started.
      </p>

      <div class="docs-search-section">
        <div id="search-ui" class="search-ui" aria-live="polite"></div>
        <noscript>
          <p>Search requires JavaScript enabled in your browser.</p>
        </noscript>
      </div>

      <div class="doc-sections">
        <section class="doc-section">
          <h2>🚀 Getting Started</h2>
          <p>New to Dasher? Start here.</p>
          <ul>
            <li>
              <a href="/docs/getting-started/install/">Installation</a> - Download and setup Dasher
            </li>
            <li>
              <a href="/docs/getting-started/how-to/tips/">Quick Start Tips</a> - Tips for new users
            </li>
            <li>
              <a href="/docs/getting-started/how-to/manual/">User Manual</a> - Complete usage guide
            </li>
            <li><a href="/docs/getting-started/">Getting Started Overview</a></li>
          </ul>
        </section>

        <section class="doc-section">
          <h2>📖 Using Dasher</h2>
          <p>Learn how Dasher works and how to use it effectively.</p>
          <ul>
            <li>
              <a href="/docs/concepts/how-dasher-works/">How Dasher Works</a> - The library concept and
              probability
            </li>
            <li><a href="/docs/concepts/">Concepts Overview</a></li>
            <li>
              <a href="/about/#demonstrations">Video Demonstrations</a> - Watch Dasher in action
            </li>
            <li>
              <a href="/docs/special-needs/">Accessibility</a> - Dasher for special needs users
            </li>
          </ul>
        </section>

        <section class="doc-section">
          <h2>⚙️ Customization</h2>
          <p>Personalize Dasher for your needs.</p>
          <ul>
            <li><a href="/docs/languages/">Languages</a> - Supported languages overview</li>
            <li>
              <a href="/docs/languages/creating-alphabets/">Creating Custom Alphabets</a> - Add new languages
            </li>
            <li>
              <a href="/docs/reference/parameters/">Settings & Parameters</a> - Configure Dasher
            </li>
            <li><a href="/downloads/">Downloads</a> - Alphabets and training texts</li>
          </ul>
        </section>

        <section class="doc-section">
          <h2>📚 Reference</h2>
          <p>Lookup and troubleshooting.</p>
          <ul>
            <li><a href="/faq/">FAQ</a> - Frequently asked questions</li>
            <li><a href="/docs/reference/">Reference</a> - Technical reference</li>
            <li><a href="/docs/tutorials/">Tutorials</a> - Advanced tutorials</li>
          </ul>
        </section>

        <section class="doc-section">
          <h2>🔬 Research & Development</h2>
          <p>For researchers and developers.</p>
          <ul>
            <li>
              <a href="/developers/">Developer handbook</a> - Architecture, build guides, and contributing
              (v6)
            </li>
            <li>
              <a href="/docs/development/">Integrating DasherCore</a> - C API and pre-built binaries
            </li>
            <li>
              <a href="/docs/research/future-directions/">Future Directions</a> - Research roadmap
            </li>
            <li><a href="/docs/research/publications/">Publications</a> - Academic papers</li>
            <li><a href="/docs/research/presentations/">Presentations</a> - Talks and demos</li>
            <li><a href="/docs/research/press/">Press Coverage</a> - Media articles</li>
            <li><a href="/docs/history/">History</a> - Project history and team</li>
          </ul>
        </section>

        <section class="doc-section">
          <h2>👥 Community</h2>
          <p>Connect with other users and developers.</p>
          <ul>
            <li><a href="/about/#community">Community</a> - Join the discussion</li>
            <li><a href="/blog/">Blog</a> - News and updates</li>
            <li>
              <a
                href="https://matrix.to/#/#dasher:matrix.org"
                target="_blank"
                rel="noopener noreferrer">Matrix Chat</a
              > - Real-time help
            </li>
            <li>
              <a href="https://github.com/dasher-project" target="_blank" rel="noopener noreferrer"
                >GitHub Discussions</a
              >
            </li>
          </ul>
        </section>
      </div>

      <div class="cta-box">
        <h2>Need Help?</h2>
        <p>
          Join our <a href="https://matrix.to/#/#dasher:matrix.org">Matrix chat room</a> or check the
          <a href="/faq/">FAQ</a> for quick answers.
        </p>
      </div>
    </section>
  </div>
</DocsLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline type="module">
  const mount = document.getElementById('search-ui');

  if (!mount) {
    throw new Error('Search mount not found');
  }

  const showFallback = () => {
    mount.innerHTML = `
      <div class="search-fallback">
        <p>Search index not available in this environment yet.</p>
        <p>Run <code>npm run build</code> to generate Pagefind assets, then open this page from the built site.</p>
      </div>
    `;
  };

  const loadPagefindUI = () =>
    new Promise((resolve, reject) => {
      if (window.PagefindUI) {
        resolve(window.PagefindUI);
        return;
      }

      const existing = document.querySelector('script[data-pagefind-ui]');
      if (existing) {
        existing.addEventListener('load', () => {
          if (window.PagefindUI) resolve(window.PagefindUI);
          else reject(new Error('Pagefind UI loaded without global constructor'));
        });
        existing.addEventListener('error', () => reject(new Error('Failed to load Pagefind UI')));
        return;
      }

      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.async = true;
      script.dataset.pagefindUi = 'true';
      script.onload = () => {
        if (window.PagefindUI) resolve(window.PagefindUI);
        else reject(new Error('Pagefind UI loaded without global constructor'));
      };
      script.onerror = () => reject(new Error('Failed to load Pagefind UI'));
      document.head.appendChild(script);
    });

  try {
    const PagefindUI = await loadPagefindUI();
    new PagefindUI({
      element: '#search-ui',
      showSubResults: true,
      resetStyles: false,
      autofocus: false,
      placeholder: 'Search docs, guides, and pages...',
      translations: {
        clear_search: 'Clear',
        load_more: 'Load more results',
        search_label: 'Search documentation',
      },
    });
  } catch (error) {
    console.error(error);
    showFallback();
  }
</script>

<style>
  .docs-search-section {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
  }
</style>
