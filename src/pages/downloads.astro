---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Downloads - Dasher">
  <div class="container">
    <section class="section">
      <h1>Downloads</h1>

      <p class="lead">
        Download Dasher for your platform, alphabet files, training texts, and other resources.
      </p>

      <!-- Current Releases Section - NEW -->
      <section class="download-section">
        <h2><span class="highlight">⬇️</span> Get Dasher</h2>
        <p>
          Download the latest stable version of Dasher for your platform.
          <a href="/docs/getting-started/install/">View installation instructions →</a>
        </p>

        <div class="platform-downloads">
          <div class="platform-download">
            <div class="platform-icon">🪟</div>
            <div class="platform-info">
              <h3>Windows</h3>
              <p>v5.0 - Latest stable release</p>
              <a
                href="https://github.com/dasher-project/dasher/releases"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary">Download from GitHub</a
              >
              <a href="/docs/getting-started/install/windows/" class="link">Installation guide →</a>
            </div>
          </div>

          <div class="platform-download">
            <div class="platform-icon">🍎</div>
            <div class="platform-info">
              <h3>macOS</h3>
              <p>v5.14 - Updated for recent macOS</p>
              <a
                href="https://github.com/dasher-project/dasher/releases"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary">Download DMG</a
              >
              <a href="/docs/getting-started/install/macos/" class="link">Installation guide →</a>
            </div>
          </div>

          <div class="platform-download">
            <div class="platform-icon">🐧</div>
            <div class="platform-info">
              <h3>Linux</h3>
              <p>Install from your package manager</p>
              <code>sudo apt-get install dasher</code>
              <a href="/docs/getting-started/install/linux/" class="link">Installation guide →</a>
            </div>
          </div>

          <div class="platform-download">
            <div class="platform-icon">🤖</div>
            <div class="platform-info">
              <h3>Android</h3>
              <p>Dasher v6 preview beta &mdash; built on DasherCore C API</p>
              <a
                href="https://github.com/dasher-project/Dasher-Android/releases/latest"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary">Download APK (beta)</a
              >
              <a
                href="https://github.com/dasher-project/Dasher-Android"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary">Source Code</a
              >
              <a href="/docs/getting-started/install/android/" class="link">Installation guide →</a>
            </div>
          </div>

          <div class="platform-download">
            <div class="platform-icon">📱</div>
            <div class="platform-info">
              <h3>iOS</h3>
              <p>Available on the App Store for iPhone and iPad</p>
              <a
                href="https://apps.apple.com/app/dasher"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary">App Store →</a
              >
              <a href="/docs/getting-started/install/ios/" class="link">Installation guide →</a>
            </div>
          </div>
        </div>

        <div class="info-box" style="margin-top: var(--space-lg);">
          <h3>🧪 Dasher v6 Preview Beta</h3>
          <p>
            The v6 rewrite is in open preview beta across Windows, iOS, macOS, visionOS and Android.
            These builds are real, usable Dasher but still have rough edges. See the
            <a href="/blog/preview-beta-windows-apple/">preview beta announcement</a> for download links
            and what's included, or check the
            <a href="/status/">feature status matrix</a> for exactly what each platform supports.
          </p>
        </div>

        <div class="info-box community-builds-box" style="margin-top: var(--space-md);">
          <h3>🧑‍💻 Community Builds</h3>
          <p>
            <strong>Dasher Mobile</strong> is an Android implementation developed by Ján Murin as part
            of his bachelor's thesis at Masaryk University. It builds on DasherCore and integrates KenLM
            language models with a focus on Slovak language support. The project is in active user testing.
          </p>
          <p>
            <a
              href="https://github.com/janmurin2/Dasher-Mobile"
              target="_blank"
              rel="noopener noreferrer">View on GitHub</a
            >
            ·
            <a
              href="https://github.com/janmurin2/Dasher-Mobile/releases/tag/v1.0"
              target="_blank"
              rel="noopener noreferrer">Download v1.0 APK</a
            >
          </p>
        </div>
        <div class="info-box" style="margin-top: var(--space-md);">
          <h3>📊 Feature &amp; platform status</h3>
          <p>
            Wondering exactly what Dasher supports on each platform &mdash; input methods,
            languages, speech and more? See the live
            <a href="/status/">feature &amp; platform status matrix</a>.
          </p>
        </div>
      </section>

      <!-- Alphabet Files Section -->
      <section class="download-section">
        <h2><span class="highlight">Community</span> Builds &amp; Experiments</h2>
        <p>
          These independent projects are built by the community &mdash; not official Dasher v6
          releases, but they showcase the range of what Dasher can do. Have a project to add?
          <a href="https://github.com/dasher-project" target="_blank" rel="noopener noreferrer"
            >Let us know on GitHub Discussions</a
          >.
        </p>

        <div class="community-grid">
          <div class="community-card">
            <h3>Dasher-JS (React)</h3>
            <p class="community-author">Jamie Brew</p>
            <p>
              Word-level Dasher for constrained writing, built in React. Created by the founder of
              Botnik (comedy predictive text).
            </p>
            <a
              href="https://frigital.onrender.com/tools/dasher/"
              target="_blank"
              rel="noopener noreferrer">Live demo &rarr;</a
            >
            <a href="https://github.com/jbrew/dasher-js" target="_blank" rel="noopener noreferrer"
              >Source code &rarr;</a
            >
          </div>

          <div class="community-card">
            <h3>Jasher (musical Dasher)</h3>
            <p class="community-author">Jossy Sayir</p>
            <p>
              A variant of Dasher for composing and generating live music. Zoom through notes and
              phrases instead of letters.
            </p>
            <a href="https://js851.net/jd/jasher.html" target="_blank" rel="noopener noreferrer"
              >Try it &rarr;</a
            >
            <a href="https://js851.net/jd/" target="_blank" rel="noopener noreferrer"
              >More experiments &rarr;</a
            >
          </div>

          <div class="community-card">
            <h3>DasherJava</h3>
            <p class="community-author">Jan Schulte</p>
            <p>
              A clean, modern Java reimplementation of Dasher as a master's thesis. PPM language
              model, ~1,300 LOC, Java Swing GUI.
            </p>
            <a
              href="https://gitfront.io/r/janschu99/JR2GxTjT1wJz/DasherJava/"
              target="_blank"
              rel="noopener noreferrer">Code &rarr;</a
            >
            <a
              href="https://github.com/janschu99/SimpleDasherLanguageModel"
              target="_blank"
              rel="noopener noreferrer">Language model comparison &rarr;</a
            >
          </div>

          <div class="community-card">
            <h3>Dasher Mobile (Android)</h3>
            <p class="community-author">J&aacute;n Murin</p>
            <p>
              Native Android app built on DasherCore with KenLM integration and Slovak language
              support. Bachelor's thesis at Masaryk University.
            </p>
            <a
              href="https://github.com/janmurin2/Dasher-Mobile"
              target="_blank"
              rel="noopener noreferrer">Source code &rarr;</a
            >
            <a
              href="https://github.com/janmurin2/Dasher-Mobile/releases/tag/v1.0"
              target="_blank"
              rel="noopener noreferrer">Download APK &rarr;</a
            >
          </div>
        </div>

        <p>
          Read more about these projects in our
          <a href="/blog/community-dasher-projects/">community projects blog post</a>.
        </p>
      </section>

      <section class="download-section">
        <h2>Alphabet Files</h2>

        <p>
          Dasher supports over 60 languages through alphabet XML files. These files define the
          characters, ordering, and display properties for each language.
        </p>

        <div class="download-options">
          <a href="/download/alphabets/all.zip" class="download-card">
            <h3>All Alphabets</h3>
            <p>Complete package with all alphabet files</p>
            <span class="file-size">~410KB</span>
          </a>

          <a href="/download/training.html" class="download-card">
            <h3>Training Texts</h3>
            <p>Training files for 50+ languages</p>
            <span class="file-size">View index</span>
          </a>
        </div>

        <div class="alphabet-list">
          <h3>Individual Alphabet Files</h3>
          <p class="note">
            Browse individual alphabet files by language. These files can be placed in Dasher's
            alphabet directory to add language support.
          </p>

          <div class="language-groups">
            <div class="group">
              <h4>European Languages</h4>
              <div class="files">
                <a href="/download/alphabets/alphabet.english.xml">English</a>
                <a href="/download/alphabets/alphabet.french.xml">French</a>
                <a href="/download/alphabets/alphabet.german.xml">German</a>
                <a href="/download/alphabets/alphabet.spanish.xml">Spanish</a>
                <a href="/download/alphabets/alphabet.italian.xml">Italian</a>
                <a href="/download/alphabets/alphabet.portuguese.xml">Portuguese</a>
                <a href="/download/alphabets/alphabet.dutch.xml">Dutch</a>
                <a href="/download/alphabets/alphabet.swedish.xml">Swedish</a>
                <a href="/download/alphabets/alphabet.danish.xml">Danish</a>
                <a href="/download/alphabets/alphabet.norwegian.xml">Norwegian</a>
                <a href="/download/alphabets/alphabet.finnish.xml">Finnish</a>
                <a href="/download/alphabets/alphabet.polish.xml">Polish</a>
                <a href="/download/alphabets/alphabet.czech.xml">Czech</a>
                <a href="/download/alphabets/alphabet.hungarian.xml">Hungarian</a>
                <a href="/download/alphabets/alphabet.Greek.xml">Greek</a>
                <a href="/download/alphabets/alphabet.russian.xml">Russian</a>
                <a href="/download/alphabets/alphabet.Bulgarian.xml">Bulgarian</a>
              </div>
            </div>

            <div class="group">
              <h4>Middle-Eastern Languages</h4>
              <div class="files">
                <a href="/download/alphabets/alphabet.arabic.xml">Arabic</a>
                <a href="/download/alphabets/alphabet.Hebrew.xml">Hebrew</a>
                <a href="/download/alphabets/alphabet.persian.xml">Persian (Farsi)</a>
              </div>
            </div>

            <div class="group">
              <h4>Indian Languages</h4>
              <div class="files">
                <a href="/download/alphabets/alphabet.Hindi.xml">Hindi</a>
                <a href="/download/alphabets/alphabet.bengali.xml">Bengali</a>
                <a href="/download/alphabets/alphabet.Tamil.xml">Tamil</a>
                <a href="/download/alphabets/alphabet.Telugu.xml">Telugu</a>
                <a href="/download/alphabets/alphabet.Kannada.xml">Kannada</a>
                <a href="/download/alphabets/alphabet.Malayalam.xml">Malayalam</a>
                <a href="/download/alphabets/alphabet.Gujarati.xml">Gujarati</a>
                <a href="/download/alphabets/alphabet.Punjabi.xml">Punjabi</a>
                <a href="/download/alphabets/alphabet.Marathi.xml">Marathi</a>
                <a href="/download/alphabets/alphabet.Oriya.xml">Oriya</a>
                <a href="/download/alphabets/alphabet.Assamese.xml">Assamese</a>
                <a href="/download/alphabets/alphabet.Urdu.xml">Urdu</a>
              </div>
            </div>

            <div class="group">
              <h4>Asian Languages</h4>
              <div class="files">
                <a href="/download/alphabets/alphabet.hiragana.xml">Japanese (Hiragana)</a>
                <a href="/download/alphabets/alphabet.Katakana.xml">Japanese (Katakana)</a>
                <a href="/download/alphabets/alphabet.korean.xml">Korean</a>
                <a href="/download/alphabets/alphabet.Thai.xml">Thai</a>
                <a href="/download/alphabets/alphabet.mongolian.xml">Mongolian</a>
                <a href="/download/alphabets/alphabet.chinese.xml">Chinese (Simplified)</a>
              </div>
            </div>

            <div class="group">
              <h4>African Languages</h4>
              <div class="files">
                <a href="/download/alphabets/alphabet.swahili.xml">Swahili</a>
                <a href="/download/alphabets/alphabet.afrikaans.xml">Afrikaans</a>
                <a href="/download/alphabets/alphabet.Zulu.xml">Zulu</a>
                <a href="/download/alphabets/alphabet.Xhosa.xml">Xhosa</a>
              </div>
            </div>

            <div class="group">
              <h4>Other Languages</h4>
              <div class="files">
                <a href="/download/alphabets/alphabet.Esperanto.xml">Esperanto</a>
                <a href="/download/alphabets/alphabet.Turkish.xml">Turkish</a>
                <a href="/download/alphabets/alphabet.Icelandic.xml">Icelandic</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="download-section">
        <h2>How to Install Alphabet Files</h2>

        <div class="platform-instructions">
          <div class="platform">
            <h4>Windows</h4>
            <ol>
              <li>Download the alphabet file</li>
              <li>Place it in: <code>C:\Program Files\Dasher\alphabets\</code></li>
              <li>Restart Dasher</li>
              <li>Select <strong>Options → Alphabet</strong> to choose your language</li>
            </ol>
          </div>

          <div class="platform">
            <h4>Linux</h4>
            <ol>
              <li>Download the alphabet file</li>
              <li>Place it in: <code>/usr/share/dasher/alphabets/</code></li>
              <li>Or use <code>~/.dasher/alphabets/</code> for user-specific files</li>
              <li>Restart Dasher</li>
              <li>Select <strong>Options → Alphabet</strong> to choose your language</li>
            </ol>
          </div>

          <div class="platform">
            <h4>macOS</h4>
            <ol>
              <li>Download the alphabet file</li>
              <li>Right-click Dasher.app and select "Show Package Contents"</li>
              <li>Navigate to <code>Contents/Resources/alphabets/</code></li>
              <li>Copy the file there</li>
              <li>Restart Dasher</li>
              <li>Select <strong>Options → Alphabet</strong> to choose your language</li>
            </ol>
          </div>
        </div>
      </section>

      <section class="download-section">
        <h2>Creating Custom Alphabets</h2>

        <p>
          Want to create your own alphabet file? See our guide on
          <a href="/docs/languages/creating-alphabets/">Creating Custom Alphabets</a>.
        </p>

        <div class="info-box">
          <h3>Need Help?</h3>
          <p>
            If you need help with alphabet files or want to contribute one you've created, please <a
              href="https://github.com/dasher-project"
              target="_blank"
              rel="noopener noreferrer"
            >
              contact us on GitHub Discussions</a
            >.
          </p>
        </div>
      </section>
    </section>
  </div>
</BaseLayout>

<style>
  .highlight {
    color: var(--color-target-coral);
  }

  .platform-downloads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }

  .platform-download {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border: 2px solid var(--color-horizon-mint);
    border-radius: var(--radius-lg);
    align-items: center;
    transition: var(--transition-smooth);
  }

  .platform-download:hover {
    border-color: var(--color-target-coral);
    transform: translateY(-2px);
  }

  .platform-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .platform-info {
    flex: 1;
  }

  .platform-info h3 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .platform-info p {
    margin-bottom: var(--space-sm);
    opacity: 0.9;
  }

  .platform-info code {
    background-color: var(--color-horizon-mint);
    padding: 0.125rem 0.25rem;
    border-radius: var(--radius-sm);
    font-family: monospace;
  }

  @media (max-width: 768px) {
    .platform-download {
      flex-direction: column;
      text-align: center;
    }
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-lg) 0;
  }

  .community-card {
    padding: var(--space-lg);
    background-color: var(--color-canvas-white);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .community-card h3 {
    margin: 0;
  }

  .community-author {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .community-card p {
    font-size: 0.9rem;
    margin: 0;
  }

  .community-card a {
    font-size: 0.85rem;
    font-weight: 500;
  }
</style>
